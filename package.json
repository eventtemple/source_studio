		"configuration": {
			"title": "Source Studio",
			"properties": {
				"sourcestudio.gitPath": {
					"type": "string",
					"default": "git",
					"description": "Path to the git executable."
				},
				"sourcestudio.scanDepth": {
					"type": "number",
					"default": 3,
					"description": "How many folder levels below each workspace folder to scan for repositories."
				},
				"sourcestudio.ignoredFolders": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [
						"node_modules",
						".git",
						"dist",
						"build",
						"vendor",
						"tmp",
						".next"
					],
					"description": "Folder names skipped when scanning for repositories."
				},
				"sourcestudio.commit.branchPrefixPattern": {
					"type": "string",
					"default": "(?:^|/)([A-Z][A-Z0-9]+-\\d+)",
					"description": "Regex run against the branch name; the first capture group (or whole match) seeds the commit subject. Empty to disable."
				},
				"sourcestudio.commit.branchPrefixFormat": {
					"type": "string",
					"default": "{match}: ",
					"description": "How the branch match is inserted into the subject. {match} is replaced."
				},
				"sourcestudio.commit.templateFiles": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [
						".gitmessage",
						".gitmessage.txt",
						".github/COMMIT_TEMPLATE.md",
						".github/commit_template.md",
						".github/pull_request_template.md",
						"pull_request_template.md",
						"docs/pull_request_template.md"
					],
					"description": "Files (relative to the repository root) to pre-fill the commit description from, tried in order. git's commit.template setting always takes precedence."
				}
			}
