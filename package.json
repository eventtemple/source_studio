{
	"name": "source-studio",
	"displayName": "Source Studio",
	"description": "lazygit-style source control for VS Code: multi-repo status, keyboard-driven staging, branches, worktrees, stashes, a commit graph, interactive rebase, blame and undo.",
	"version": "1.0.0",
	"publisher": "EventTemple",
	"license": "MIT",
	"icon": "media/icon-128.png",
	"galleryBanner": {
		"color": "#242936",
		"theme": "dark"
	},
	"keywords": [
		"git",
		"lazygit",
		"source control",
		"scm",
		"rebase",
		"worktree",
		"stash",
		"blame",
		"commit graph"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/eventtemple/source_studio"
	},
	"bugs": {
		"url": "https://github.com/eventtemple/source_studio/issues"
	},
	"homepage": "https://github.com/eventtemple/source_studio#readme",
	"engines": {
		"vscode": "^1.90.0"
	},
	"categories": [
		"SCM Providers"
	],
	"extensionKind": [
		"workspace"
	],
	"activationEvents": [
		"onStartupFinished",
		"workspaceContains:**/.git"
	],
	"main": "./dist/extension.js",
	"contributes": {
		"viewsContainers": {
			"activitybar": [
				{
					"id": "sourcestudio",
					"title": "Source Studio",
					"icon": "$(source-control)"
				}
			]
		},
		"views": {
			"sourcestudio": [
				{
					"id": "sourcestudio.repos",
					"name": "Repositories",
					"icon": "$(repo)"
				},
				{
					"id": "sourcestudio.files",
					"name": "Files",
					"icon": "$(files)"
				},
				{
					"id": "sourcestudio.branches",
					"name": "Branches",
					"icon": "$(git-branch)"
				},
				{
					"id": "sourcestudio.worktrees",
					"name": "Worktrees",
					"icon": "$(folder-library)"
				},
				{
					"id": "sourcestudio.commits",
					"name": "Commits",
					"type": "webview",
					"icon": "$(git-commit)"
				},
				{
					"id": "sourcestudio.stashes",
					"name": "Stashes",
					"icon": "$(archive)"
				}
			]
		},
		"viewsWelcome": [
			{
				"view": "sourcestudio.repos",
				"contents": "No git repositories found in this workspace.\n[Refresh](command:sourcestudio.refresh)",
				"when": "!sourcestudio.hasRepos"
			}
		],
		"commands": [
			{
				"command": "sourcestudio.refresh",
				"title": "Refresh",
				"category": "Source Studio",
				"icon": "$(refresh)"
			},
			{
				"command": "sourcestudio.setActiveRepo",
				"title": "Set Active Repository",
				"category": "Source Studio"
			},
			{
				"command": "sourcestudio.pickActiveRepo",
				"title": "Pick Active Repository",
				"category": "Source Studio",
				"icon": "$(repo)"
			},
			{
				"command": "sourcestudio.openDiff",
				"title": "Open Diff",
				"category": "Source Studio",
				"icon": "$(diff)"
			},
			{
				"command": "sourcestudio.openFile",
				"title": "Open File",
				"category": "Source Studio",
				"icon": "$(go-to-file)"
			},
			{
				"command": "sourcestudio.stage",
				"title": "Stage",
				"category": "Source Studio",
				"icon": "$(add)"
			},
			{
				"command": "sourcestudio.unstage",
				"title": "Unstage",
				"category": "Source Studio",
				"icon": "$(remove)"
			},
			{
				"command": "sourcestudio.toggleStage",
				"title": "Toggle Staged",
				"category": "Source Studio"
			},
			{
				"command": "sourcestudio.stageAll",
				"title": "Stage All",
				"category": "Source Studio",
				"icon": "$(add)"
			},
			{
				"command": "sourcestudio.unstageAll",
				"title": "Unstage All",
				"category": "Source Studio",
				"icon": "$(remove)"
			},
			{
				"command": "sourcestudio.discard",
				"title": "Discard Changes",
				"category": "Source Studio",
				"icon": "$(discard)"
			},
			{
				"command": "sourcestudio.commit",
				"title": "Commit",
				"category": "Source Studio",
				"icon": "$(check)"
			},
			{
				"command": "sourcestudio.push",
				"title": "Push",
				"category": "Source Studio",
				"icon": "$(arrow-up)"
			},
			{
				"command": "sourcestudio.pull",
				"title": "Pull",
				"category": "Source Studio",
				"icon": "$(arrow-down)"
			},
			{
				"command": "sourcestudio.fetch",
				"title": "Fetch",
				"category": "Source Studio",
				"icon": "$(cloud-download)"
			},
			{
				"command": "sourcestudio.showKeymap",
				"title": "Show Keymap",
				"category": "Source Studio",
				"icon": "$(question)"
			},
			{
				"command": "sourcestudio.checkoutBranch",
				"title": "Checkout",
				"category": "Source Studio",
				"icon": "$(arrow-right)"
			},
			{
				"command": "sourcestudio.newBranch",
				"title": "New Branch",
				"category": "Source Studio",
				"icon": "$(add)"
			},
			{
				"command": "sourcestudio.deleteBranch",
				"title": "Delete Branch",
				"category": "Source Studio",
				"icon": "$(trash)"
			},
			{
				"command": "sourcestudio.renameBranch",
				"title": "Rename Branch",
				"category": "Source Studio",
				"icon": "$(edit)"
			},
			{
				"command": "sourcestudio.rebaseOnto",
				"title": "Rebase Current Branch Onto This",
				"category": "Source Studio",
				"icon": "$(git-merge)"
			},
			{
				"command": "sourcestudio.mergeInto",
				"title": "Merge Into Current Branch",
				"category": "Source Studio",
				"icon": "$(git-pull-request)"
			},
			{
				"command": "sourcestudio.fastForward",
				"title": "Fast-Forward From Upstream",
				"category": "Source Studio",
				"icon": "$(fold-down)"
			},
			{
				"command": "sourcestudio.setUpstream",
				"title": "Set Upstream",
				"category": "Source Studio",
				"icon": "$(link)"
			},
			{
				"command": "sourcestudio.continueOperation",
				"title": "Continue (rebase/merge)",
				"category": "Source Studio",
				"icon": "$(debug-continue)"
			},
			{
				"command": "sourcestudio.abortOperation",
				"title": "Abort (rebase/merge)",
				"category": "Source Studio",
				"icon": "$(debug-stop)"
			},
			{
				"command": "sourcestudio.showStash",
				"title": "Show Stash",
				"category": "Source Studio",
				"icon": "$(diff)"
			},
			{
				"command": "sourcestudio.applyStash",
				"title": "Apply Stash",
				"category": "Source Studio",
				"icon": "$(arrow-right)"
			},
			{
				"command": "sourcestudio.popStash",
				"title": "Pop Stash",
				"category": "Source Studio",
				"icon": "$(arrow-up)"
			},
			{
				"command": "sourcestudio.dropStash",
				"title": "Drop Stash",
				"category": "Source Studio",
				"icon": "$(trash)"
			},
			{
				"command": "sourcestudio.createStash",
				"title": "Stash Changes",
				"category": "Source Studio",
				"icon": "$(archive)"
			},
			{
				"command": "sourcestudio.switchWorktree",
				"title": "Switch to Worktree",
				"category": "Source Studio",
				"icon": "$(arrow-right)"
			},
			{
				"command": "sourcestudio.addWorktree",
				"title": "New Worktree",
				"category": "Source Studio",
				"icon": "$(add)"
			},
			{
				"command": "sourcestudio.removeWorktree",
				"title": "Remove Worktree",
				"category": "Source Studio",
				"icon": "$(trash)"
			},
			{
				"command": "sourcestudio.pruneWorktrees",
				"title": "Prune Worktrees",
				"category": "Source Studio",
				"icon": "$(clear-all)"
			},
			{
				"command": "sourcestudio.showCommit",
				"title": "Show Commit",
				"category": "Source Studio",
				"icon": "$(diff)"
			},
			{
				"command": "sourcestudio.checkoutCommit",
				"title": "Checkout Commit (detached)",
				"category": "Source Studio"
			},
			{
				"command": "sourcestudio.branchFromCommit",
				"title": "New Branch at Commit",
				"category": "Source Studio"
			},
			{
				"command": "sourcestudio.cherryPick",
				"title": "Cherry-pick onto Current Branch",
				"category": "Source Studio"
			},
			{
				"command": "sourcestudio.revertCommit",
				"title": "Revert Commit",
				"category": "Source Studio"
			},
			{
				"command": "sourcestudio.resetToCommit",
				"title": "Reset to Commit…",
				"category": "Source Studio"
			},
			{
				"command": "sourcestudio.copySha",
				"title": "Copy SHA",
				"category": "Source Studio"
			},
			{
				"command": "sourcestudio.squashCommit",
				"title": "Squash into Parent",
				"category": "Source Studio"
			},
			{
				"command": "sourcestudio.fixupCommit",
				"title": "Fixup into Parent",
				"category": "Source Studio"
			},
			{
				"command": "sourcestudio.rewordCommit",
				"title": "Reword Commit",
				"category": "Source Studio"
			},
			{
				"command": "sourcestudio.dropCommit",
				"title": "Drop Commit",
				"category": "Source Studio"
			},
			{
				"command": "sourcestudio.editCommit",
				"title": "Edit Commit (pause rebase here)",
				"category": "Source Studio"
			},
			{
				"command": "sourcestudio.moveCommitDown",
				"title": "Move Commit Down",
				"category": "Source Studio"
			},
			{
				"command": "sourcestudio.moveCommitUp",
				"title": "Move Commit Up",
				"category": "Source Studio"
			},
			{
				"command": "sourcestudio.amendCommit",
				"title": "Amend HEAD with Staged Changes",
				"category": "Source Studio",
				"icon": "$(edit)"
			},
			{
				"command": "sourcestudio.undo",
				"title": "Undo Last Action",
				"category": "Source Studio",
				"icon": "$(discard)"
			},
			{
				"command": "sourcestudio.redo",
				"title": "Redo",
				"category": "Source Studio",
				"icon": "$(redo)"
			},
			{
				"command": "sourcestudio.showReflog",
				"title": "Browse Reflog…",
				"category": "Source Studio",
				"icon": "$(history)"
			},
			{
				"command": "sourcestudio.stageSelection",
				"title": "Stage Selected Lines",
				"category": "Source Studio",
				"icon": "$(add)"
			},
			{
				"command": "sourcestudio.stageHunk",
				"title": "Stage Hunk at Cursor",
				"category": "Source Studio"
			},
			{
				"command": "sourcestudio.unstageSelection",
				"title": "Unstage Selected Lines",
				"category": "Source Studio",
				"icon": "$(remove)"
			},
			{
				"command": "sourcestudio.unstageHunk",
				"title": "Unstage Hunk at Cursor",
				"category": "Source Studio"
			},
			{
				"command": "sourcestudio.discardSelection",
				"title": "Discard Selected Lines",
				"category": "Source Studio",
				"icon": "$(discard)"
			},
			{
				"command": "sourcestudio.discardHunk",
				"title": "Discard Hunk at Cursor",
				"category": "Source Studio"
			},
			{
				"command": "sourcestudio.toggleFileBlame",
				"title": "Toggle File Blame",
				"category": "Source Studio",
				"icon": "$(person)"
			},
			{
				"command": "sourcestudio.toggleLineBlame",
				"title": "Toggle Line Blame",
				"category": "Source Studio"
			},
			{
				"command": "sourcestudio.showLineBlame",
				"title": "Show Line Blame",
				"category": "Source Studio"
			},
			{
				"command": "sourcestudio.showCommitSha",
				"title": "Show Commit by SHA",
				"category": "Source Studio"
			},
			{
				"command": "sourcestudio.copyText",
				"title": "Copy",
				"category": "Source Studio"
			}
		],
		"menus": {
			"commandPalette": [
				{
					"command": "sourcestudio.setActiveRepo",
					"when": "false"
				},
				{
					"command": "sourcestudio.openDiff",
					"when": "false"
				},
				{
					"command": "sourcestudio.openFile",
					"when": "false"
				},
				{
					"command": "sourcestudio.stage",
					"when": "false"
				},
				{
					"command": "sourcestudio.unstage",
					"when": "false"
				},
				{
					"command": "sourcestudio.discard",
					"when": "false"
				},
				{
					"command": "sourcestudio.checkoutBranch",
					"when": "false"
				},
				{
					"command": "sourcestudio.deleteBranch",
					"when": "false"
				},
				{
					"command": "sourcestudio.renameBranch",
					"when": "false"
				},
				{
					"command": "sourcestudio.rebaseOnto",
					"when": "false"
				},
				{
					"command": "sourcestudio.mergeInto",
					"when": "false"
				},
				{
					"command": "sourcestudio.fastForward",
					"when": "false"
				},
				{
					"command": "sourcestudio.setUpstream",
					"when": "false"
				},
				{
					"command": "sourcestudio.continueOperation",
					"when": "sourcestudio.operation"
				},
				{
					"command": "sourcestudio.abortOperation",
					"when": "sourcestudio.operation"
				},
				{
					"command": "sourcestudio.showStash",
					"when": "false"
				},
				{
					"command": "sourcestudio.applyStash",
					"when": "false"
				},
				{
					"command": "sourcestudio.popStash",
					"when": "false"
				},
				{
					"command": "sourcestudio.dropStash",
					"when": "false"
				},
				{
					"command": "sourcestudio.switchWorktree",
					"when": "false"
				},
				{
					"command": "sourcestudio.removeWorktree",
					"when": "false"
				},
				{
					"command": "sourcestudio.showCommit",
					"when": "false"
				},
				{
					"command": "sourcestudio.checkoutCommit",
					"when": "false"
				},
				{
					"command": "sourcestudio.branchFromCommit",
					"when": "false"
				},
				{
					"command": "sourcestudio.cherryPick",
					"when": "false"
				},
				{
					"command": "sourcestudio.revertCommit",
					"when": "false"
				},
				{
					"command": "sourcestudio.resetToCommit",
					"when": "false"
				},
				{
					"command": "sourcestudio.copySha",
					"when": "false"
				},
				{
					"command": "sourcestudio.squashCommit",
					"when": "false"
				},
				{
					"command": "sourcestudio.fixupCommit",
					"when": "false"
				},
				{
					"command": "sourcestudio.rewordCommit",
					"when": "false"
				},
				{
					"command": "sourcestudio.dropCommit",
					"when": "false"
				},
				{
					"command": "sourcestudio.editCommit",
					"when": "false"
				},
				{
					"command": "sourcestudio.moveCommitDown",
					"when": "false"
				},
				{
					"command": "sourcestudio.moveCommitUp",
					"when": "false"
				},
				{
					"command": "sourcestudio.stageSelection",
					"when": "isInDiffEditor"
				},
				{
					"command": "sourcestudio.stageHunk",
					"when": "isInDiffEditor"
				},
				{
					"command": "sourcestudio.unstageSelection",
					"when": "isInDiffEditor"
				},
				{
					"command": "sourcestudio.unstageHunk",
					"when": "isInDiffEditor"
				},
				{
					"command": "sourcestudio.discardSelection",
					"when": "isInDiffEditor"
				},
				{
					"command": "sourcestudio.discardHunk",
					"when": "isInDiffEditor"
				},
				{
					"command": "sourcestudio.showCommitSha",
					"when": "false"
				},
				{
					"command": "sourcestudio.copyText",
					"when": "false"
				}
			],
			"view/title": [
				{
					"command": "sourcestudio.refresh",
					"when": "view == sourcestudio.repos",
					"group": "navigation@9"
				},
				{
					"command": "sourcestudio.commit",
					"when": "view == sourcestudio.files",
					"group": "navigation@1"
				},
				{
					"command": "sourcestudio.stageAll",
					"when": "view == sourcestudio.files",
					"group": "navigation@2"
				},
				{
					"command": "sourcestudio.unstageAll",
					"when": "view == sourcestudio.files",
					"group": "navigation@3"
				},
				{
					"command": "sourcestudio.fetch",
					"when": "view == sourcestudio.files",
					"group": "navigation@4"
				},
				{
					"command": "sourcestudio.pull",
					"when": "view == sourcestudio.files",
					"group": "navigation@5"
				},
				{
					"command": "sourcestudio.push",
					"when": "view == sourcestudio.files",
					"group": "navigation@6"
				},
				{
					"command": "sourcestudio.showKeymap",
					"when": "view == sourcestudio.files",
					"group": "navigation@9"
				},
				{
					"command": "sourcestudio.continueOperation",
					"when": "view =~ /^sourcestudio\\.(files|branches)$/ && sourcestudio.operation",
					"group": "navigation@0"
				},
				{
					"command": "sourcestudio.abortOperation",
					"when": "view =~ /^sourcestudio\\.(files|branches)$/ && sourcestudio.operation",
					"group": "navigation@0"
				},
				{
					"command": "sourcestudio.newBranch",
					"when": "view == sourcestudio.branches",
					"group": "navigation@1"
				},
				{
					"command": "sourcestudio.fetch",
					"when": "view == sourcestudio.branches",
					"group": "navigation@2"
				},
				{
					"command": "sourcestudio.showKeymap",
					"when": "view == sourcestudio.branches",
					"group": "navigation@9"
				},
				{
					"command": "sourcestudio.createStash",
					"when": "view == sourcestudio.files",
					"group": "navigation@7"
				},
				{
					"command": "sourcestudio.createStash",
					"when": "view == sourcestudio.stashes",
					"group": "navigation@1"
				},
				{
					"command": "sourcestudio.addWorktree",
					"when": "view == sourcestudio.worktrees",
					"group": "navigation@1"
				},
				{
					"command": "sourcestudio.pruneWorktrees",
					"when": "view == sourcestudio.worktrees",
					"group": "navigation@2"
				},
				{
					"command": "sourcestudio.amendCommit",
					"when": "view == sourcestudio.files",
					"group": "navigation@1"
				},
				{
					"command": "sourcestudio.undo",
					"when": "view == sourcestudio.commits",
					"group": "navigation@1"
				},
				{
					"command": "sourcestudio.showReflog",
					"when": "view == sourcestudio.commits",
					"group": "navigation@2"
				},
				{
					"command": "sourcestudio.showReflog",
					"when": "view == sourcestudio.branches",
					"group": "navigation@3"
				}
			],
			"view/item/context": [
				{
					"command": "sourcestudio.openFile",
					"when": "view == sourcestudio.files && viewItem =~ /^file:/",
					"group": "inline@1"
				},
				{
					"command": "sourcestudio.stage",
					"when": "view == sourcestudio.files && viewItem =~ /^(file|dir|group):(unstaged|untracked|conflicted)$/",
					"group": "inline@2"
				},
				{
					"command": "sourcestudio.unstage",
					"when": "view == sourcestudio.files && viewItem =~ /^(file|dir|group):staged$/",
					"group": "inline@2"
				},
				{
					"command": "sourcestudio.discard",
					"when": "view == sourcestudio.files && viewItem =~ /^(file|dir|group):(unstaged|untracked)$/",
					"group": "inline@3"
				},
				{
					"command": "sourcestudio.openDiff",
